MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=travel_photo_saas
MYSQL_USER=travel_photo
MYSQL_PASSWORD=change_this_database_password
MYSQL_PORT=3306

NODE_ENV=development
DATABASE_URL="mysql://travel_photo:change_this_database_password@localhost:3306/travel_photo_saas"
PORT=3000
APP_VERSION=development
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SEED_ADMIN_PASSWORD=replace_with_admin_seed_password
SEED_OWNER_PASSWORD=replace_with_owner_seed_password
SEED_STAFF_PASSWORD=replace_with_staff_seed_password
VITE_API_BASE_URL=http://localhost:3000/api

# CloudBase 云存储。仅本地开发需要长期密钥；云托管生产环境应使用运行时身份。
CLOUDBASE_ENV_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
MAX_UPLOAD_MB=20
