page{background:#f3f6f5;color:#20362f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:32rpx}.card{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 10rpx 34rpx rgba(30,65,52,.06)}.title{font-size:42rpx;font-weight:700;margin-bottom:12rpx}.muted{font-size:25rpx;color:#7d8984;line-height:1.6}.field{margin:28rpx 0}.label{display:block;font-size:25rpx;font-weight:600;margin-bottom:13rpx}.input,.picker,.textarea{box-sizing:border-box;width:100%;background:#f6f8f7;border:1rpx solid #e5eae7;border-radius:15rpx;padding:22rpx;font-size:28rpx}.textarea{min-height:150rpx}.primary{background:#315c4e!important;color:#fff!important;border-radius:16rpx!important}.secondary{border:1rpx solid #315c4e!important;color:#315c4e!important;background:#fff!important;border-radius:16rpx!important}.tag{display:inline-block;padding:7rpx 14rpx;border-radius:20rpx;background:#e7f0ec;color:#315c4e;font-size:22rpx}
