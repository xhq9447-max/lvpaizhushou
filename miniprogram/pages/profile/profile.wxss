.profile-card{display:flex;align-items:center;gap:24rpx;padding:40rpx 12rpx 34rpx}.avatar{width:104rpx;height:104rpx;border-radius:34rpx;background:linear-gradient(145deg,#315c4e,#6c9687);color:#fff;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:700}.name{font-size:38rpx;font-weight:750}.phone{font-size:23rpx;color:#84908b;margin-top:10rpx}.stats{display:flex;justify-content:space-between;align-items:center}.number{font-size:44rpx;font-weight:750;color:#315c4e}.stats-link{font-size:24rpx;color:#315c4e}.menu{padding-top:8rpx;padding-bottom:8rpx}.menu-item{display:flex;justify-content:space-between;align-items:center;padding:30rpx 4rpx;border-bottom:1rpx solid #edf0ef;font-size:28rpx}.menu-item:last-child{border-bottom:0}.menu-item text:last-child{color:#a5aeaa;font-size:38rpx}.version{text-align:center;color:#a6aeab;font-size:21rpx;margin-top:40rpx}
