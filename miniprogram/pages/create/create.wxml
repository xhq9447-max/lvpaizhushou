<view class="page">
  <view class="state-card" wx:if="{{loading}}">
    <view class="state-title">正在读取门店信息</view>
    <view class="muted">请稍候…</view>
  </view>
  <view class="state-card" wx:elif="{{loadError}}">
    <view class="state-title">暂时无法创建订单</view>
    <view class="error-text">{{loadError}}</view>
    <button class="secondary retry" bindtap="retry">重新加载</button>
  </view>
  <block wx:else>
  <view class="header"><view class="eyebrow">CREATE ORDER</view><view class="title">{{merchantName}}</view><view class="muted">扫码门店已自动确认，只需授权联系人并选择日期。</view></view>
  <view class="card">
    <view class="section-title">联系人</view>
    <view class="contact" wx:if="{{contactAuthorized}}">
      <view class="contact-avatar">{{contactInitial}}</view>
      <view class="contact-info"><view class="contact-name">{{customerName || '微信用户'}}</view><view class="contact-phone">{{customerPhone}}</view></view>
      <view class="verified">微信已授权</view>
    </view>
    <view class="authorize-box" wx:else>
      <view class="authorize-copy"><view class="authorize-title">授权微信联系人</view><view class="muted">仅用于本次服务联系和订单通知</view></view>
      <button class="wechat-button" open-type="getPhoneNumber" bindgetphonenumber="authorizeContact" loading="{{authorizing}}" disabled="{{authorizing}}">微信授权</button>
    </view>
  </view>
  <view class="card">
    <view class="section-title">服务安排</view>
    <view class="field"><text class="label">扫码门店</text><view class="store-box"><view class="store-mark">店</view><view><view class="store-name">{{selectedStore.name}}</view><view class="store-address">{{selectedStore.address || '门店地址请以通知为准'}}</view></view><view class="locked">已锁定</view></view></view>
    <view class="field"><text class="label">预约日期 <text class="required">必填</text></text><picker mode="date" start="{{minDate}}" value="{{appointmentDate}}" bindchange="chooseDate"><view class="picker {{appointmentDate ? 'has-value' : ''}}">{{appointmentDate || '请选择到店日期'}}</view></picker></view>
    <view class="field"><text class="label">套餐或拍摄需求 <text class="optional">选填</text></text><input class="input" placeholder="例如：古城双人旅拍" placeholder-class="placeholder" value="{{packageName}}" bindinput="onPackageInput"/></view>
    <view class="field"><text class="label">补充说明 <text class="optional">选填</text></text><textarea class="textarea" maxlength="1000" placeholder="人数、服装或其他需求" placeholder-class="placeholder" value="{{notes}}" bindinput="onNotesInput"/></view>
  </view>
  <button class="primary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">提交服务订单</button>
  <view class="agreement">提交即表示同意门店为履行旅拍服务使用以上信息</view>
  </block>
</view>
