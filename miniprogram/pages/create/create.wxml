<view class="page" wx:if="{{!loading}}"><view class="title">{{merchantName}}</view><view class="muted">填写资料后，门店将确认订单并安排服务。</view><view class="card"><view class="field"><text class="label">姓名</text><input class="input" data-field="customerName" bindinput="input"/></view><view class="field"><text class="label">手机号</text><input class="input" type="number" data-field="customerPhone" bindinput="input"/></view><view class="field"><text class="label">门店</text><picker range="{{stores}}" range-key="name" bindchange="chooseStore"><view class="picker">{{stores[storeIndex].name || '请选择'}}</view></picker></view><view class="field"><text class="label">套餐或需求</text><input class="input" data-field="packageName" bindinput="input"/></view><view class="field"><text class="label">补充说明</text><textarea class="textarea" data-field="notes" bindinput="input"/></view><button class="primary" loading="{{saving}}" bindtap="submit">提交订单</button></view></view>
