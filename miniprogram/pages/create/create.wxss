.header{padding:18rpx 8rpx 30rpx}.eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#7d8984;margin-bottom:14rpx}.section-title{font-size:30rpx;font-weight:700;margin-bottom:18rpx}.state-card{background:#fff;border-radius:24rpx;padding:44rpx 34rpx;margin-top:30rpx;text-align:center}.state-title{font-size:31rpx;font-weight:700;margin-bottom:14rpx}.error-text{font-size:25rpx;color:#a24a3f;line-height:1.6}.retry{margin-top:28rpx}.contact{display:flex;align-items:center;min-height:88rpx}.contact-avatar{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:50%;background:#e7f0ec;color:#315c4e;font-size:32rpx;font-weight:700}.contact-info{flex:1;margin-left:20rpx}.contact-name{font-size:29rpx;font-weight:700;line-height:1.5}.contact-phone{font-size:25rpx;color:#68766f;line-height:1.5}.verified,.locked{font-size:20rpx;color:#315c4e;background:#e7f0ec;border-radius:20rpx;padding:8rpx 13rpx}.authorize-box{display:flex;align-items:center;gap:18rpx}.authorize-copy{flex:1}.authorize-title{font-size:28rpx;font-weight:700;margin-bottom:7rpx}.wechat-button{flex:none;margin:0;background:#07c160!important;color:#fff!important;font-size:24rpx;line-height:72rpx;height:72rpx;border-radius:14rpx;padding:0 24rpx}.store-box{display:flex;position:relative;align-items:center;box-sizing:border-box;width:100%;min-height:106rpx;background:#f6f8f7;border:1rpx solid #e5eae7;border-radius:15rpx;padding:18rpx 86rpx 18rpx 18rpx}.store-mark{display:flex;align-items:center;justify-content:center;flex:none;width:58rpx;height:58rpx;border-radius:15rpx;background:#315c4e;color:#fff;font-size:22rpx;margin-right:17rpx}.store-name{font-size:28rpx;font-weight:700;line-height:1.45}.store-address{font-size:22rpx;color:#7d8984;line-height:1.5}.locked{position:absolute;right:16rpx;top:50%;transform:translateY(-50%)}.required,.optional{display:inline-block;font-size:19rpx;font-weight:500;border-radius:16rpx;padding:3rpx 10rpx;margin-left:8rpx;vertical-align:2rpx}.required{c