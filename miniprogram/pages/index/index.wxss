.hero{background:linear-gradient(145deg,#244a3d,#416f5f);color:#fff;border-radius:30rpx;padding:46rpx 36rpx;margin-bottom:24rpx;box-shadow:0 18rpx 44rpx rgba(36,74,61,.22)}
.eyebrow{font-size:19rpx;letter-spacing:4rpx;opacity:.7}.hero-title{font-size:46rpx;line-height:1.25;font-weight:700;margin:22rpx 0 14rpx;max-width:560rpx}.hero-desc{font-size:26rpx;line-height:1.7;opacity:.82}.hero-button{margin-top:32rpx;background:#fff!important;color:#315c4e!important;border-radius:16rpx!important;font-weight:600}.section-title{font-size:30rpx;font-weight:700}.code-row,.section-head,.order-top{display:flex;align-items:center;justify-content:space-between}.code-row{margin-top:22rpx;gap:18rpx}.code-input{flex:1}.compact{width:180rpx;margin:0;font-size:26rpx}.section-head{padding:18rpx 6rpx 20rpx}.link{font-size:25rpx;color:#315c4e}.empty{text-align:center;padding:56rpx 32rpx}.empty-title{font-size:30rpx;font-weight:600;margin-bottom:10rpx}.merchant{font-size:25rpx;color:#6d7c76}.order-package{font-size:32rpx;font-weight:650;margin:24rpx 0 12rpx}.order-card{position:relative}
