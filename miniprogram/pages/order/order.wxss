.summary{background:linear-gradient(140deg,#fff,#f4f8f6)}.summary-top,.file-head{display:flex;justify-content:space-between;align-items:flex-start}.merchant{font-size:24rpx;color:#6d7c76}.order-title{font-size:38rpx;font-weight:700;margin:12rpx 0 18rpx}.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:28rpx;padding-top:24rpx;border-top:1rpx solid #edf0ef;font-size:25rpx}.caption{display:block;color:#8a9691;font-size:21rpx;margin-bottom:8rpx}.section-title{font-size:30rpx;font-weight:700;margin-bottom:24rpx}.timeline{position:relative;display:inline-flex;flex-direction:column;align-items:center;width:25%;height:116rpx;vertical-align:top}.dot{width:18rpx;height:18rpx;border-radius:50%;background:#dce3e0;z-index:2}.dot.done{background:#315c4e}.dot.current{box-shadow:0 0 0 9rpx #e6efeb}.line{position:absolute;left:50%;top:8rpx;width:100%;height:3rpx;background:#dce3e0}.done-line{background:#76988b}.step-label{font-size:21rpx;color:#89948f;text-align:center;margin-top:20rpx;line-height:1.4}.current-label{color:#315c4e;font-weight:700}.person,.addon,.file{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-top:1rpx solid #edf0ef}.person:first-of-type,.addon:first-of-type{border-top:0}.person-role{font-size:22rpx;color:#8a9691}.person-name{font-size:29rpx;font-weight:650;margin-top:5rpx}.light-tag{font-size:22rpx;color:#315c4e;background:#eef4f1;padding:8rpx 14rpx;border-radius:20rpx}.addon-main{flex:1}.addon-name{font-size:28rpx;font-weight:650;margin-bottom:8rpx}.addon-actions{margin-left:20rpx}.addon-actions button{margin:6rpx 0}.dispute{font-size:22rpx;color:#b36a40;margin-top:7rpx}.empty-line{padding:10rpx 0}.action-button{margin-top:24rpx}.count{font-size:22rpx;color:#7d8984}.file-icon{width:64rpx;height:64rpx;border-radius:14rpx;background:#edf4f1;color:#315c4e;display:flex;align-items:center;justify-content:center;font-size:21rpx;font-weight:700}.file-info{flex:1;min-width:0;margin:0 18rpx}.file-name{font-size:26rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.arrow{font-size:40rpx;color:#a7b0ac}.upload-actions{display:flex;gap:18rpx;margin-top:24rpx}.upload-actions button{flex:1;font-size:25rpx}.plain{background:#f4f6f5!important;color:#40534c!important}.contact{background:transparent!important;color:#315c4e!important;margin:8rpx 0 50rpx}
