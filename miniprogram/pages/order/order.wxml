<view class="page" wx:if="{{!loading && order}}"><view class="card"><view class="title">{{order.customer.name}}</view><text class="tag">{{statusLabel}}</text><view class="muted order-no">{{order.orderNo}} · {{order.store.name}}</view></view><view class="card"><view class="section-title">服务人员</view><block wx:for="{{order.serviceRecords}}" wx:key="id"><view class="row" wx:if="{{item.isCurrent}}"><text>{{item.stage === 'MAKEUP' ? '化妆师' : '摄影师'}}</text><text>{{item.employee.name}}</text></view></block></view><view class="card"><view class="section-title">增值服务确认</view><view wx:if="{{!order.valueAddedServices.length}}" class="muted">暂无增值服务</view><view class="addon" wx:for="{{order.valueAddedServices}}" wx:key="id"><view><text class="addon-name">{{item.name}} × {{item.quantity}}</text><view class="muted">{{item.employee.name}} · ¥{{item.totalAmount}}</view></view><view wx:if="{{item.status === 'PENDING'}}"><button size="mini" class="primary" data-id="{{item.id}}" bindtap="confirmAddon">确认</button><button size="mini" data-id="{{item.id}}" bindtap="disputeAddon">异议</button></view><text wx:else class="tag">{{item.status === 'CONFIRMED' ? '已确认' : '有异议'}}</text></view></view><view class="card selection" wx:if="{{order.status === 'WAITING_SELECTION' || order.status === 'WAITING_RETOUCH'}}"><view class="section-title">外部软件选片</view><view class="muted" wx:if="{{order.status === 'WAITING_SELECTION'}}">请在门店指定的软件中完成选片，然后在这里确认。</view><view class="muted" wx:else>选片已经确认，正在等待后期修片。</view><button wx:if="{{order.status === 'WAITING_SELECTION'}}" class="primary" bindtap="confirmSelection">确认已完成选片</button></view></view>
