NODE_ENV=production
PORT=3000
APP_VERSION=replace_with_release_version
DATABASE_URL="mysql://APP_USER:URL_ENCODED_PASSWORD@CLOUDBASE_MYSQL_HOST:3306/travel_photo_saas?connection_limit=10&pool_timeout=20&connect_timeout=10"
CORS_ORIGIN=https://admin.example.com,https://example.com
JWT_ACCESS_SECRET=inject_from_cloudbase_secret_manager_at_least_32_chars
JWT_REFRESH_SECRET=inject_a_different_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLOUDBASE_ENV_ID=replace_with_cloudbase_env_id
MAX_UPLOAD_MB=20

# 云托管中使用运行时身份，不要配置或写入长期密钥。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
