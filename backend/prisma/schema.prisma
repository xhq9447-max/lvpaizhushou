generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum StoreStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EmployeeStatus {
  ACTIVE
  DISABLED
}

enum Plan {
  TRIAL
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum RoleCode {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTION
  SALES
  MAKEUP
  PHOTOGRAPHER
  RETOUCHER
}

enum OrderStatus {
  PENDING_CONFIRMATION
  WAITING_MAKEUP
  MAKEUP_IN_PROGRESS
  WAITING_PHOTOGRAPHY
  PHOTOGRAPHY_IN_PROGRESS
  WAITING_SELECTION
  WAITING_RETOUCH
  COMPLETED
  CANCELLED
}

enum ServiceStage {
  MAKEUP
  PHOTOGRAPHY
}

enum ServiceRecordStatus {
  CLAIMED
  IN_PROGRESS
  COMPLETED
  REPLACED
}

enum ValueAddedStatus {
  PENDING
  CONFIRMED
  DISPUTED
  VOIDED
}

enum FileCategory {
  PHOTO
  DOCUMENT
  OTHER
}

model Merchant {
  id           String         @id @default(cuid())
  name         String
  merchantCode String         @unique @map("merchant_code")
  logo         String?
  contactName  String?        @map("contact_name")
  contactPhone String?        @map("contact_phone")
  status       MerchantStatus @default(ACTIVE)
  plan         Plan           @default(TRIAL)
  expireAt     DateTime?      @map("expire_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  stores       Store[]
  users        User[]
  employees    Employee[]
  roles        Role[]
  logs         OperationLog[]
  customers    Customer[]
  orders       Order[]
  files        FileAsset[]

  @@index([status])
  @@map("merchants")
}

model Store {
  id           String      @id @default(cuid())
  merchantId   String      @map("merchant_id")
  name         String
  address      String?
  contactPhone String?     @map("contact_phone")
  status       StoreStatus @default(ACTIVE)
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  merchant     Merchant    @relation(fields: [merchantId], references: [id])
  employees    Employee[]
  orders       Order[]

  @@index([merchantId])
  @@index([merchantId, status])
  @@index([merchantId, name])
  @@map("stores")
}

model User {
  id            String         @id @default(cuid())
  merchantId    String?        @map("merchant_id")
  username      String         @unique
  phone         String?
  passwordHash  String         @map("password_hash")
  wechatOpenid  String?        @unique @map("wechat_openid")
  wechatUnionid String?        @map("wechat_unionid")
  role          RoleCode
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  merchant      Merchant?      @relation(fields: [merchantId], references: [id])
  employee      Employee?
  refreshTokens RefreshToken[]
  operationLogs OperationLog[] @relation("OperatorLogs")
  uploadedFiles FileAsset[]    @relation("UploadedFiles")

  @@index([merchantId])
  @@index([merchantId, phone])
  @@map("users")
}

model Employee {
  id                 String              @id @default(cuid())
  merchantId         String              @map("merchant_id")
  storeId            String?             @map("store_id")
  userId             String?             @unique @map("user_id")
  name               String
  phone              String
  role               RoleCode
  avatar             String?
  status             EmployeeStatus      @default(ACTIVE)
  joinDate           DateTime?           @map("join_date") @db.Date
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  merchant           Merchant            @relation(fields: [merchantId], references: [id])
  store              Store?              @relation(fields: [storeId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  serviceRecords     ServiceRecord[]
  valueAddedServices ValueAddedService[]

  @@unique([merchantId, phone])
  @@index([merchantId])
  @@index([merchantId, storeId])
  @@index([merchantId, role])
  @@map("employees")
}

model Customer {
  id           String   @id @default(cuid())
  merchantId   String   @map("merchant_id")
  name         String
  phone        String
  wechatOpenid String?  @map("wechat_openid")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  orders       Order[]

  @@unique([merchantId, phone])
  @@index([merchantId, name])
  @@map("customers")
}

model Order {
  id                   String              @id @default(cuid())
  merchantId           String              @map("merchant_id")
  storeId              String              @map("store_id")
  customerId           String              @map("customer_id")
  orderNo              String              @unique @map("order_no")
  accessToken          String              @unique @map("access_token") @db.VarChar(64)
  status               OrderStatus         @default(PENDING_CONFIRMATION)
  packageName          String?             @map("package_name")
  appointmentAt        DateTime?           @map("appointment_at")
  notes                String?             @db.Text
  confirmedAt          DateTime?           @map("confirmed_at")
  selectionConfirmedAt DateTime?           @map("selection_confirmed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  store                Store               @relation(fields: [storeId], references: [id])
  customer             Customer            @relation(fields: [customerId], references: [id])
  serviceRecords       ServiceRecord[]
  valueAddedServices   ValueAddedService[]

  @@index([merchantId, status])
  @@index([merchantId, storeId, appointmentAt])
  @@index([customerId])
  @@map("orders")
}

model ServiceRecord {
  id                 String              @id @default(cuid())
  merchantId         String              @map("merchant_id")
  orderId            String              @map("order_id")
  employeeId         String              @map("employee_id")
  stage              ServiceStage
  status             ServiceRecordStatus @default(CLAIMED)
  isCurrent          Boolean             @default(true) @map("is_current")
  claimedAt          DateTime            @default(now()) @map("claimed_at")
  startedAt          DateTime?           @map("started_at")
  completedAt        DateTime?           @map("completed_at")
  replacedAt         DateTime?           @map("replaced_at")
  replacementReason  String?             @map("replacement_reason")
  previousRecordId   String?             @map("previous_record_id")
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  order              Order               @relation(fields: [orderId], references: [id])
  employee           Employee            @relation(fields: [employeeId], references: [id])
  valueAddedServices ValueAddedService[]

  @@index([merchantId, orderId, stage])
  @@index([merchantId, employeeId, status])
  @@index([orderId, stage, isCurrent])
  @@map("service_records")
}

model ValueAddedService {
  id              String           @id @default(cuid())
  merchantId      String           @map("merchant_id")
  orderId         String           @map("order_id")
  serviceRecordId String           @map("service_record_id")
  employeeId      String           @map("employee_id")
  stage           ServiceStage
  name            String
  quantity        Int              @default(1)
  unitAmount      Decimal          @map("unit_amount") @db.Decimal(10, 2)
  totalAmount     Decimal          @map("total_amount") @db.Decimal(10, 2)
  status          ValueAddedStatus @default(PENDING)
  description     String?          @db.Text
  customerNote    String?          @map("customer_note") @db.Text
  confirmedAt     DateTime?        @map("confirmed_at")
  disputedAt      DateTime?        @map("disputed_at")
  voidedAt        DateTime?        @map("voided_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  order           Order            @relation(fields: [orderId], references: [id])
  serviceRecord   ServiceRecord    @relation(fields: [serviceRecordId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])

  @@index([merchantId, orderId, status])
  @@index([employeeId, status])
  @@map("value_added_services")
}

model FileAsset {
  id           String       @id @default(cuid())
  merchantId   String       @map("merchant_id")
  uploaderId   String       @map("uploader_id")
  fileId       String       @unique @map("file_id") @db.VarChar(512)
  url          String?      @db.Text
  cloudPath    String       @map("cloud_path")
  originalName String       @map("original_name")
  mimeType     String       @map("mime_type")
  size         Int
  category     FileCategory @default(OTHER)
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  merchant     Merchant     @relation(fields: [merchantId], references: [id])
  uploader     User         @relation("UploadedFiles", fields: [uploaderId], references: [id])

  @@index([merchantId, category, createdAt])
  @@index([uploaderId, createdAt])
  @@map("file_assets")
}

model Role {
  id          String           @id @default(cuid())
  merchantId  String?          @map("merchant_id")
  name        String
  code        RoleCode
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  merchant    Merchant?        @relation(fields: [merchantId], references: [id])
  permissions RolePermission[]

  @@unique([merchantId, code])
  @@index([merchantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OperationLog {
  id         String    @id @default(cuid())
  merchantId String?   @map("merchant_id")
  operatorId String?   @map("operator_id")
  action     String
  resource   String
  resourceId String?   @map("resource_id")
  detail     Json?
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  operator   User?     @relation("OperatorLogs", fields: [operatorId], references: [id])

  @@index([merchantId, createdAt])
  @@index([operatorId, createdAt])
  @@map("operation_logs")
}
